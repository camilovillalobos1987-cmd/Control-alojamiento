# Copiar este archivo como .env y completar los valores

# Clave secreta para Flask y QR (CAMBIAR en producción)
SECRET_KEY=cambiar_esta_clave_super_secreta_32chars

# Clave Fernet para encriptar tokens QR (generar con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
QR_FERNET_KEY=

# Configuración Gmail (usar variables de entorno en Railway, NUNCA commitear claves)
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Nombre de la empresa / campamento
NOMBRE_EMPRESA=Campamento Minero

# Base de datos
# - Vacío (por defecto): SQLite local en DATABASE_PATH (desarrollo).
# - Producción: URL de PostgreSQL administrado. En Railway, agregar el plugin
#   PostgreSQL y copiar su DATABASE_URL como variable de entorno del servicio.
#   Ejemplo: postgresql://postgres:clave@host:5432/railway
DATABASE_URL=
DATABASE_PATH=campamento.db

# Puerto del servidor
PORT=5000
